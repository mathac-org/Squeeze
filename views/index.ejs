<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Squeeze - Options Analyzer</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .container { max-width: 1200px; margin-top: 50px; }
        .squeeze-row { background-color: #d4edda !important; font-weight: bold; }
        .header-section { margin-bottom: 30px; text-align: center; }
        #resultsTable { margin-top: 30px; }
        .loading-spinner { display: none; margin: 20px auto; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header-section">
            <h1>🍋 Squeeze</h1>
            <p class="lead">Historical vs. Implied Volatility Analysis for Options</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <form id="analyzeForm" class="row g-3">
                    <div class="col-md-3">
                        <label for="ticker" class="form-label">Stock Ticker</label>
                        <input type="text" class="form-control" id="ticker" placeholder="e.g. XLK" required>
                    </div>
                    <div class="col-md-3">
                        <label for="expiry" class="form-label">Expiration Date</label>
                        <select class="form-select" id="expiry" required disabled>
                            <option value="">Enter ticker first...</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Option Type</label>
                        <div class="mt-2">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="optionType" id="typeCall" value="call" checked>
                                <label class="form-check-label" for="typeCall">Call</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="optionType" id="typePut" value="put">
                                <label class="form-check-label" for="typePut">Put</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="optionType" id="typeBoth" value="both">
                                <label class="form-check-label" for="typeBoth">Both</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100" id="submitBtn">Analyze Squeeze</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="text-center">
            <div class="spinner-border text-primary loading-spinner" role="status" id="spinner">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>

        <div id="resultsArea" style="display: none;">
            <div class="alert alert-info mt-4">
                Underlying Price for <span id="resTicker"></span>: <strong>$<span id="resPrice"></span></strong>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover mt-3" id="resultsTable">
                    <thead class="table-dark">
                        <tr>
                            <th>Strike</th>
                            <th>Type</th>
                            <th>HV</th>
                            <th>IV</th>
                            <th>Diff (HV-IV)</th>
                            <th>Fair Price</th>
                            <th>Market Price</th>
                            <th>POP</th>
                            <th>Expected Value</th>
                        </tr>
                    </thead>
                    <tbody id="resultsBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="/js/app.js"></script>
</body>
</html>
